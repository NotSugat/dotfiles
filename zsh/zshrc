# grub update
alias update-grub="sudo grub-mkconfig -o /boot/grub/grub.cfg"

# file size
alias du='du -h'

# nvim shortcut
nv () {
	if [ "$#" -eq 0 ]; then
		nvim .
	else
		nvim "$@"
	fi
}

hx () {
	if [ "$#" -eq 0 ]; then
		helix .
	else
		helix "$@"
	fi
}

# nvim shortcut for lazy-nvim config
nl () {
    if [ "$#" -eq 0 ]; then
        NVIM_APPNAME=lazy-nvim nvim .
    else
        NVIM_APPNAME=lazy-nvim nvim "$@"
    fi
}

